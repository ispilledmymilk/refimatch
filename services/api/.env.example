REFIMATCH_LLM_MOCK=1
REFIMATCH_RAG_BACKEND=memory
REFIMATCH_RAG_TOP_K=4
DATABASE_URL=postgresql://refimatch:refimatch@localhost:5432/refimatch
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
OPENAI_API_KEY=
REFIMATCH_CORS_ORIGINS=*

# Live refinance offers — RateAPI (credit unions)
# Without a key: uses https://api.rateapi.dev/v1/demo/rates (keyless sample)
# With a free key: live rates — curl -X POST https://api.rateapi.dev/keys -d '{"email":"you@example.com"}'
REFIMATCH_RATEAPI_KEY=
REFIMATCH_RATEAPI_URL=https://api.rateapi.dev
REFIMATCH_RATE_STATE=TX
REFIMATCH_DEFAULT_LENDER_FEES=2495

# Optional: free FRED API key (CSV fallback works without it)
# https://fred.stlouisfed.org/docs/api/api_key.html
REFIMATCH_FRED_API_KEY=

# Live listings provider (default: Mirror Real Estate MCP, no key required)
REFIMATCH_MIRROR_MCP_URL=https://www.mirrorrealestate.com/mcp
REFIMATCH_LIVE_CACHE_TTL=300
